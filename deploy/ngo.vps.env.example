# Copy to /var/www/crowdfunding/.env on the VPS. Never paste keys from another organization.

NODE_ENV=production
PORT=3001
SITE_DOMAIN=giving.example.org
NEXT_PUBLIC_APP_URL=https://giving.example.org
NEXT_PUBLIC_PUBLIC_SITE_URL=https://giving.example.org
APP_NAME="Giving Site"
ADMIN_EMAIL=admin@example.com
REFUND_EMAIL=
EMAIL_LOGO_URL=
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# VAULT_ENCRYPTION_KEY=
LOCAL_ADMIN_BYPASS=false
APP_ROLE=all
TZ=America/Los_Angeles
NEXT_ASSET_PREFIX=/__giving

# New Supabase project for this organization only.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# This organization's Stripe account. Placeholders only.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# This organization's PayPal app. Leave empty to hide the button.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=

# Optional. Writes gateway product names from each campaign story.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GATEWAY_NAMES_PROVIDER=
# GATEWAY_NAMES_MODEL=

RESEND_API_KEY=re_xxx
RESEND_FROM="Giving Site <hello@example.com>"
CRON_SECRET=replace-with-a-random-secret

# This organization's Utmify token. Leave empty until the account exists.
UTMIFY_API_TOKEN=

# Leave empty. This storefront does not use PagNovo.
PAGNOVO_SECRET_KEY=
PAGNOVO_WEBHOOK_SECRET=

# Leave empty. Purchases are not sent to Meta CAPI.
# META_CAPI_ACCESS_TOKEN=
# META_PIXEL_ID=

VAPID_SUBJECT=mailto:admin@example.com
